# ==========================================
# CONFIGURACIÓN DE PRODUCCIÓN ODOO 18
# ==========================================

# Dominio del cliente (ejemplo: erp.cliente.com)
# Caddy obtendrá automáticamente el certificado SSL HTTPS para este dominio.
DOMAIN_NAME=erp.midominio.com

# Email para alertas de vencimiento/renovación de SSL (opcional pero recomendado)
ACME_EMAIL=admin@midominio.com

# Credenciales de Base de Datos PostgreSQL
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CambiarEstaContrasenaSuperSegura123!
POSTGRES_DB=postgres

# Contraseña Maestra de Administración de Odoo (Para crear/restaurar BDs)
ODOO_ADMIN_PASSWORD=CambiarMasterSecretOdoo2026!
