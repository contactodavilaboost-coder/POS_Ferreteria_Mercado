<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kamaleon_dashboard.SalesDashboardAction" owl="1">
        <div class="o_kamaleon_sales_dashboard">
            <!-- ── HEADER & CONTROLS ────────────────────────────────────────── -->
            <div class="dashboard-header">
                <div class="dashboard-title">
                    <h1><i class="fa fa-shopping-basket"/> Tablero de Analítica POS</h1>
                    <p>Ferretería Mercado — Métricas de Punto de Venta &amp; Retail en Tiempo Real</p>
                </div>
                <div class="dashboard-controls">
                    <!-- Preset Filter Buttons -->
                    <div class="preset-filters btn-group me-2" role="group">
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('today')">Hoy</button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('week')">Esta Semana</button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('month')">Este Mes</button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('last_month')">Mes Anterior</button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('year')">Año 2026</button>
                        <button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.onPresetClick('all')">Todo</button>
                    </div>

                    <input type="date" t-model="state.dateFrom" t-on-change="onDateChange"/>
                    <span class="text-white-50">a</span>
                    <input type="date" t-model="state.dateTo" t-on-change="onDateChange"/>
                    <button class="btn-refresh" t-on-click="fetchAnalyticsData">
                        <i class="fa fa-refresh"/> Actualizar
                    </button>
                </div>
            </div>

            <!-- ── KPI STAT TILES ───────────────────────────────────────────── -->
            <div class="kpi-tiles-grid">
                <!-- KPI 1: Ventas POS Totales -->
                <div class="kpi-card" t-on-click="() => this.openPosOrders()" style="cursor: pointer;" title="Ver pedidos POS">
                    <div class="kpi-icon bg-blue"><i class="fa fa-shopping-cart"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Ventas POS Totales</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_sales)"/></div>
                        <div class="kpi-subtext"><t t-esc="state.kpis.total_orders"/> Tickets Cobrados</div>
                    </div>
                </div>

                <!-- KPI 2: Ticket Promedio -->
                <div class="kpi-card">
                    <div class="kpi-icon bg-emerald"><i class="fa fa-calculator"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Ticket Promedio</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.avg_ticket)"/></div>
                        <div class="kpi-subtext">Venta Media por Cliente</div>
                    </div>
                </div>

                <!-- KPI 3: Compras a Proveedores -->
                <div class="kpi-card" t-on-click="() => this.openPurchases()" style="cursor: pointer;" title="Ver compras a proveedores">
                    <div class="kpi-icon bg-amber"><i class="fa fa-truck"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Compras Realizadas</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_purchases)"/></div>
                        <div class="kpi-subtext">Reposición de Mercancía</div>
                    </div>
                </div>

                <!-- KPI 4: Valoración de Inventario (Costo) -->
                <div class="kpi-card" t-on-click="() => this.openInventoryQuants()" style="cursor: pointer;" title="Ver valoración de stock">
                    <div class="kpi-icon bg-slate"><i class="fa fa-cubes"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Inventario (Costo)</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_inv_cost)"/></div>
                        <div class="kpi-subtext">Capital en Stock al Costo</div>
                    </div>
                </div>

                <!-- KPI 5: Valoración de Inventario (PVP) -->
                <div class="kpi-card" t-on-click="() => this.openInventoryQuants()" style="cursor: pointer;" title="Ver valoración de stock">
                    <div class="kpi-icon bg-purple"><i class="fa fa-tags"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Inventario (PVP)</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_inv_sale)"/></div>
                        <div class="kpi-subtext">Proyección a Precio Venta</div>
                    </div>
                </div>

                <!-- KPI 6: Stock Crítico Ferretería -->
                <div class="kpi-card" t-on-click="() => this.openLowStockProducts()" style="cursor: pointer;" title="Ver productos por agotarse">
                    <div class="kpi-icon bg-amber"><i class="fa fa-warning"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Stock Crítico</div>
                        <div class="kpi-value"><t t-esc="state.kpis.low_stock_count"/> Prods</div>
                        <div class="kpi-subtext">Stock &lt;= 5 Unidades</div>
                    </div>
                </div>
            </div>

            <!-- ── CHARTS GRID ──────────────────────────────────────────────── -->
            <div class="charts-grid">
                <!-- CHART 1: COMPARACIÓN COMPRAS VS VENTAS -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-balance-scale"/> 1. Flujo Operativo: Compras vs Ventas POS</h3>
                        <span class="chart-badge">Balance Entradas / Salidas</span>
                    </div>
                    <div class="chart-body" style="min-height: 280px;">
                        <canvas t-ref="purchasesVsSalesCanvas"/>
                    </div>
                </div>

                <!-- CHART 2: TENDENCIA DIARIA DE VENTAS POS -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-line-chart"/> 2. Ventas Diarias del Punto de Venta</h3>
                        <span class="chart-badge">Tendencia en Dólares ($)</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="salesTrendChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 3: MÉTODOS DE COBRO (EFECTIVO, PAGO MÓVIL, TARJETA, BIOPAGO) -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-pie-chart"/> 3. Métodos de Cobro POS</h3>
                        <span class="chart-badge">Efectivo vs Digitales</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="paymentMethodsChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 4: RENDIMIENTO POR CAJA / CAJERO -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-desktop"/> 4. Ventas por Caja / Cajero</h3>
                        <span class="chart-badge">Rendimiento Operativo</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="cashierChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 5: TOP CLIENTES DE MOSTRADOR -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-users"/> 5. Clientes Más Frecuentes</h3>
                        <span class="chart-badge">Mayor Volumen de Compra</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="topClientsChartCanvas"/>
                    </div>
                </div>

                <!-- WIDGET 6: ALERTA DE STOCK CRÍTICO (TABLA) -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-exclamation-triangle text-warning"/> 6. Artículos de Ferretería con Stock Crítico</h3>
                        <span class="chart-badge bg-amber text-dark fw-bold">Atención Inmediata</span>
                    </div>
                    <div class="low-stock-table-container">
                        <table class="table table-dark table-hover table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Artículo</th>
                                    <th>Código</th>
                                    <th>Stock Actual</th>
                                    <th>Umbral Mínimo</th>
                                    <th>Estado Almacén</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.low_stock_products.length > 0">
                                    <tr t-foreach="state.low_stock_products" t-as="item" t-key="item.id">
                                        <td class="fw-bold text-white"><t t-esc="item.name"/></td>
                                        <td><span class="badge bg-secondary"><t t-esc="item.code || 'N/A'"/></span></td>
                                        <td class="text-warning fw-bold"><t t-esc="item.stock"/> <t t-esc="item.uom"/></td>
                                        <td><t t-esc="item.min_stock"/> <t t-esc="item.uom"/></td>
                                        <td>
                                            <span t-if="item.stock &lt;= 0" class="badge bg-danger">Agotado</span>
                                            <span t-elif="item.stock &lt;= item.min_stock" class="badge bg-warning text-dark">Bajo Stock</span>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            <i class="fa fa-check-circle text-success"/> Todos los artículos de ferretería cuentan con niveles de inventario óptimos.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CHART 7: TOP 50 ARTÍCULOS DE FERRETERÍA MÁS VENDIDOS -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-wrench"/> 7. Top 50 Artículos de Ferretería Más Vendidos</h3>
                        <span class="chart-badge">Ranking por Unidades Despachadas</span>
                    </div>
                    <div class="chart-body" style="min-height: 400px;">
                        <canvas t-ref="top50ChartCanvas"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
