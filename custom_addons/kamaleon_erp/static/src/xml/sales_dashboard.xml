<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="kamaleon_dashboard.SalesDashboardAction" owl="1">
        <div class="o_kamaleon_sales_dashboard">
            <!-- ── HEADER & CONTROLS ────────────────────────────────────────── -->
            <div class="dashboard-header">
                <div class="dashboard-title">
                    <h1><i class="fa fa-line-chart"/> Tablero de Analítica de Ventas</h1>
                    <p>Zais Express C.A — Indicadores Ejecutivos en Tiempo Real</p>
                </div>
                <div class="dashboard-controls">
                    <!-- Preset Filter Buttons -->
                    <div class="preset-filters btn-group me-2" role="group">
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('today')">Hoy</button>
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('week')">Esta Semana</button>
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('month')">Este Mes</button>
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('last_month')">Mes Anterior</button>
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('year')">Año 2026</button>
                        <button class="btn btn-outline-emerald btn-sm" t-on-click="() => this.onPresetClick('all')">Todo el Tiempo</button>
                    </div>

                    <input type="date" t-model="state.dateFrom" t-on-change="onDateChange"/>
                    <span class="text-white-50">a</span>
                    <input type="date" t-model="state.dateTo" t-on-change="onDateChange"/>
                    <button class="btn-refresh" t-on-click="fetchAnalyticsData">
                        <i class="fa fa-refresh"/> Actualizar
                    </button>
                </div>
            </div>

            <!-- ── KPI STAT TILES ───────────────────────────────────────────── -->
            <div class="kpi-tiles-grid">
                <div class="kpi-card">
                    <div class="kpi-icon bg-emerald"><i class="fa fa-usd"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Ventas Totales</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_sales)"/></div>
                        <div class="kpi-subtext"><t t-esc="state.kpis.total_orders"/> Pedidos Confirmados</div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon bg-blue"><i class="fa fa-file-text-o"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Total Facturado</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_invoiced)"/></div>
                        <div class="kpi-subtext">Ticket Prom: $<t t-esc="formatNumber(state.kpis.avg_ticket)"/></div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon bg-purple"><i class="fa fa-credit-card"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Total Cobrado</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_collected)"/></div>
                        <div class="kpi-subtext"><t t-esc="state.kpis.collection_rate"/>% Cobranza Efectiva</div>
                    </div>
                </div>

                <!-- NUEVAS TARJETAS DE VALORACIÓN DE INVENTARIO -->
                <div class="kpi-card">
                    <div class="kpi-icon bg-emerald"><i class="fa fa-cubes"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Valor Inv. (Costo)</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_inv_cost)"/></div>
                        <div class="kpi-subtext">Valorado a Precio Costo</div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon bg-purple"><i class="fa fa-tags"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Valor Inv. (Venta)</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_inv_sale)"/></div>
                        <div class="kpi-subtext">Valorado a Precio Venta</div>
                    </div>
                </div>

                <div class="kpi-card kpi-card-clickable" t-on-click="() => this.openOverdueInvoices()" title="Haga clic para ver las facturas vencidas">
                    <div class="kpi-icon bg-red"><i class="fa fa-exclamation-triangle"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Cartera Vencida</div>
                        <div class="kpi-value">$<t t-esc="formatNumber(state.kpis.total_overdue)"/></div>
                        <div class="kpi-subtext">
                            <span class="badge bg-danger text-white me-1"><t t-esc="state.kpis.overdue_count || 0"/> Facturas</span>
                            <i class="fa fa-external-link"/> Ver detalle
                        </div>
                    </div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-icon bg-amber"><i class="fa fa-warning"/></div>
                    <div class="kpi-details">
                        <div class="kpi-label">Stock Crítico</div>
                        <div class="kpi-value"><t t-esc="state.kpis.low_stock_count"/> Prods</div>
                        <div class="kpi-subtext">Próximos a Agotarse</div>
                    </div>
                </div>
            </div>

            <!-- ── CHARTS GRID ──────────────────────────────────────────────── -->
            <div class="charts-grid">
                <!-- NUEVO GRÁFICO: COMPARACIÓN COMPRAS VS VENTAS -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-balance-scale text-emerald"/> Comparación Compras vs Ventas</h3>
                        <span class="chart-badge bg-emerald text-dark fw-bold">Análisis Operativo</span>
                    </div>
                    <div class="chart-body" style="min-height: 280px;">
                        <canvas t-ref="purchasesVsSalesCanvas"/>
                    </div>
                </div>

                <!-- CHART 1: RESUMEN DE VENTAS DEL MES -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-area-chart"/> 1. Resumen de Ventas del Mes</h3>
                        <span class="chart-badge">Tendencia Diaria</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="salesTrendChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 2: COBRANZA EXITOSA DEL MES -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-pie-chart"/> 2. Cobranza Exitosa del Mes</h3>
                        <span class="chart-badge">Facturado vs Cobrado</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="collectionChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 3: ANÁLISIS DE CARTERA VENCIDA -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <div>
                            <h3><i class="fa fa-clock-o text-danger"/> 3. Cartera Vencida por Antigüedad</h3>
                            <div class="text-white-50" style="font-size: 0.72rem;">Calculado desde Fecha de Entrega</div>
                        </div>
                        <span class="chart-badge bg-danger text-white">Gestión de Cobranza</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="agingChartCanvas"/>
                    </div>
                </div>

                <!-- WIDGET 3B: DETALLE FACTURAS VENCIDAS DESDE ENTREGA -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <div>
                            <h3><i class="fa fa-list-alt text-danger"/> Facturas Vencidas</h3>
                            <div class="text-white-50" style="font-size: 0.72rem;">Top Facturas en Mora</div>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.75rem;" t-on-click="() => this.openOverdueInvoices()">
                            <i class="fa fa-external-link"/> Ver Todas (<t t-esc="state.kpis.overdue_count || 0"/>)
                        </button>
                    </div>
                    <div class="overdue-table-container">
                        <table class="table table-dark table-hover table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Cliente</th>
                                    <th>Factura</th>
                                    <th>Entrega</th>
                                    <th>Atraso</th>
                                    <th class="text-end">Saldo</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.overdue_invoices and state.overdue_invoices.length > 0">
                                    <tr t-foreach="state.overdue_invoices.slice(0, 8)" t-as="inv" t-key="inv.id" class="clickable-row" t-on-click="() => this.openInvoice(inv.id)" title="Haga clic para ver la factura">
                                        <td class="fw-bold text-white text-truncate" style="max-width: 130px;" t-att-title="inv.partner_name"><t t-esc="inv.partner_name"/></td>
                                        <td><span class="badge bg-secondary"><t t-esc="inv.name"/></span></td>
                                        <td><t t-esc="inv.delivery_date"/></td>
                                        <td>
                                            <span t-if="inv.days_overdue &gt; 15" class="badge bg-danger"><t t-esc="inv.overdue_info"/></span>
                                            <span t-elif="inv.days_overdue &gt; 7" class="badge bg-warning text-dark"><t t-esc="inv.overdue_info"/></span>
                                            <span t-else="" class="badge bg-info text-dark"><t t-esc="inv.overdue_info"/></span>
                                        </td>
                                        <td class="text-end text-danger fw-bold">$<t t-esc="formatNumber(inv.amount_residual)"/></td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            <i class="fa fa-check-circle text-success"/> ¡Excelente! No hay facturas entregadas con mora vencida.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CHART 8: TOP 30 CLIENTES VIP -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-star"/> 4. Top 30 Clientes VIP</h3>
                        <span class="chart-badge">Ranking por Compra ($)</span>
                    </div>
                    <div class="chart-body chart-body-top30">
                        <canvas t-ref="topClientsChartCanvas"/>
                    </div>
                </div>

                <!-- WIDGET 9: ALERTA DE PRODUCTOS PRÓXIMOS A AGOTARSE -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-warning text-warning"/> 5. Alerta de Productos Próximos a Agotarse</h3>
                        <span class="chart-badge bg-amber">Inventario Crítico</span>
                    </div>
                    <div class="low-stock-table-container">
                        <table class="table table-dark table-hover table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Código</th>
                                    <th>Stock Actual</th>
                                    <th>Stock Mínimo</th>
                                    <th>Estado Almacén</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.low_stock_products.length > 0">
                                    <tr t-foreach="state.low_stock_products" t-as="item" t-key="item.id">
                                        <td class="fw-bold text-white"><t t-esc="item.name"/></td>
                                        <td><span class="badge bg-secondary"><t t-esc="item.code || 'N/A'"/></span></td>
                                        <td class="text-warning fw-bold"><t t-esc="item.stock"/> <t t-esc="item.uom"/></td>
                                        <td><t t-esc="item.min_stock"/> <t t-esc="item.uom"/></td>
                                        <td>
                                            <span t-if="item.stock &lt;= 0" class="badge bg-danger">Agotado</span>
                                            <span t-elif="item.stock &lt;= item.min_stock" class="badge bg-warning text-dark">Bajo Stock</span>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-3">
                                            <i class="fa fa-check-circle text-success"/> Todos los productos cuentan con nivel de inventario óptimo.
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CHART 3: TOP 50 PRODUCTOS MÁS VENDIDOS -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-bar-chart"/> 6. Top 50 Productos Más Vendidos</h3>
                        <span class="chart-badge">Ranking por Unidades</span>
                    </div>
                    <div class="chart-body chart-body-top50">
                        <canvas t-ref="top50ChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 4: RESUMEN DE VENTAS POR RUTAS -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-map-marker"/> 7. Ventas por Ruta Comercial</h3>
                        <span class="chart-badge">Rutas Activas</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="routesChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 5: RESUMEN DE VENTAS POR VENDEDOR -->
                <div class="chart-card">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-users"/> 8. Ventas por Vendedor</h3>
                        <span class="chart-badge">Equipo de Ventas</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="sellersChartCanvas"/>
                    </div>
                </div>

                <!-- CHART 6: FILL RATE (PEDIDO VS ENTREGADO EN DÓLARES) -->
                <div class="chart-card full-width">
                    <div class="chart-card-header">
                        <h3><i class="fa fa-check-square-o"/> 9. Fill Rate — Pedido vs Entregado en Moneda ($)</h3>
                        <span class="chart-badge bg-emerald text-dark fw-bold">Efectividad: <t t-esc="state.data and state.data.fill_rate ? state.data.fill_rate.percent : 100"/>%</span>
                    </div>
                    <div class="chart-body">
                        <canvas t-ref="fillRateChartCanvas"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
