<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Client Action for Sales Dashboard -->
        <record id="action_kamaleon_sales_dashboard" model="ir.actions.client">
            <field name="name">Dashboard de Ventas</field>
            <field name="tag">kamaleon_sales_dashboard_action</field>
            <field name="target">current</field>
        </record>

        <!-- Main Navbar Top Menu Item (Right beside Ventas / Orders) -->
        <menuitem id="menu_kamaleon_sales_dashboard_top"
                  name="Dashboard de Ventas"
                  action="action_kamaleon_sales_dashboard"
                  parent="sale.sale_menu_root"
                  sequence="0"/>

        <!-- Submenu inside Reportes Dropdown -->
        <menuitem id="menu_kamaleon_sales_dashboard_in_report"
                  name="Dashboard de Analítica (6 Gráficos)"
                  action="action_kamaleon_sales_dashboard"
                  parent="sale.menu_sale_report"
                  sequence="0"/>
    </data>
</odoo>
