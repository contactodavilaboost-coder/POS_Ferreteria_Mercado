<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ══════════════════════════════════════════════════════════════════
             LISTA DE FACTURAS — Columnas adicionales de entrega, comisión y atraso
             ══════════════════════════════════════════════════════════════════ -->
        <record id="view_out_invoice_tree_kamaleon" model="ir.ui.view">
            <field name="name">account.move.tree.kamaleon</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="inside">
                    <field name="x_is_delivered" string="✓ Entregada" widget="boolean_toggle" optional="show"/>
                    <field name="x_delivery_date" string="Fecha Entrega" optional="show"/>
                    <field name="x_days_overdue" column_invisible="True"/>
                    <field name="x_overdue_info" string="Atraso / Vencimiento" widget="badge" 
                           decoration-danger="x_days_overdue &gt; 3"
                           decoration-warning="x_days_overdue &gt; 0 and x_days_overdue &lt;= 3"
                           decoration-info="x_days_overdue == 0 and payment_state not in ('paid', 'reversed')"
                           decoration-success="payment_state in ('paid', 'reversed')"
                           optional="show"/>
                    <field name="x_commission_rate" widget="percentage_float" string="% Comisión" optional="show"/>
                    <field name="x_commission_amount" widget="monetary" string="Monto Comisión" sum="Total Comisiones" optional="show"/>
                    <field name="x_fortnight" string="Quincena" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════
             FORMULARIO DE FACTURAS — Botón de entrega, campos editables y atraso
             ══════════════════════════════════════════════════════════════════ -->
        <record id="view_move_form_kamaleon" model="ir.ui.view">
            <field name="name">account.move.form.kamaleon</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <!-- Botones de Entrega en el Header -->
                <xpath expr="//header" position="inside">
                    <button name="action_mark_delivered"
                            type="object"
                            string="📦 Marcar Entregada"
                            class="btn-success"
                            invisible="x_is_delivered or move_type != 'out_invoice' or state != 'posted'"/>
                    <button name="action_unmark_delivered"
                            type="object"
                            string="↩ Revertir Entrega"
                            class="btn-outline-warning"
                            invisible="not x_is_delivered or move_type != 'out_invoice'"/>
                </xpath>

                <!-- Campos de Entrega en la cabecera principal junto a Fecha de Factura -->
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="x_is_delivered"
                           widget="boolean_toggle"
                           invisible="move_type != 'out_invoice'"/>
                    <field name="x_delivery_date"
                           invisible="move_type != 'out_invoice' or not x_is_delivered"
                           placeholder="Seleccione fecha de entrega"/>
                    <field name="x_overdue_info"
                           string="Estado Vencimiento"
                           readonly="1"
                           invisible="move_type != 'out_invoice' or state != 'posted'"/>
                    <field name="x_delivered_by"
                           readonly="1"
                           invisible="move_type != 'out_invoice' or not x_is_delivered"/>
                </xpath>

                <!-- Campos de Comisión y Quincena en 'Otra información' -->
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="x_commission_rate" readonly="1"/>
                    <field name="x_commission_amount" readonly="1"/>
                    <field name="x_fortnight" readonly="1"/>
                </xpath>

            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════
             ACCIÓN MASIVA: Marcar facturas seleccionadas como entregadas
             ══════════════════════════════════════════════════════════════════ -->
        <record id="action_account_move_mark_delivered_mass" model="ir.actions.server">
            <field name="name">📦 Marcar como Entregadas</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                records.action_mark_delivered()
            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════════
             BÚSQUEDA — Filtros de entrega y quincena
             ══════════════════════════════════════════════════════════════════ -->
        <record id="view_account_invoice_filter_fortnight" model="ir.ui.view">
            <field name="name">account.move.search.fortnight.kamaleon</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='myinvoices']" position="before">
                    <!-- Filtros de Entrega -->
                    <filter string="✓ Entregadas" name="delivered"
                            domain="[('x_is_delivered', '=', True)]"/>
                    <filter string="⏳ Pendientes de Entrega" name="not_delivered"
                            domain="[('x_is_delivered', '=', False), ('state', '=', 'posted'), ('move_type', '=', 'out_invoice')]"/>
                    <separator/>
                    <!-- Filtros de Quincena -->
                    <filter string="1ª Quincena (Mes Actual: 1-15)" name="fortnight_q1"
                            domain="[('x_fortnight', '=', 'q1'), ('invoice_date', '&gt;=', context_today().strftime('%Y-%m-01')), ('invoice_date', '&lt;=', context_today().strftime('%Y-%m-15'))]"/>
                    <filter string="2ª Quincena (Mes Actual: 16-Fin de Mes)" name="fortnight_q2"
                            domain="[('x_fortnight', '=', 'q2'), ('invoice_date', '&gt;=', context_today().strftime('%Y-%m-16')), ('invoice_date', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                </xpath>

                <xpath expr="//search" position="inside">
                    <group expand="0" string="Agrupar por">
                        <filter string="Quincena" name="group_by_fortnight" context="{'group_by': 'x_fortnight'}"/>
                        <filter string="Entregada" name="group_by_delivered" context="{'group_by': 'x_is_delivered'}"/>
                    </group>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
