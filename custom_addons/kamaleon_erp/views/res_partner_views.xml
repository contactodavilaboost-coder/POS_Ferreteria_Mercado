<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista de Lista para el Historial de Vendedores -->
        <record id="view_kamaleon_partner_salesperson_history_tree" model="ir.ui.view">
            <field name="name">kamaleon.partner.salesperson.history.list</field>
            <field name="model">kamaleon.partner.salesperson.history</field>
            <field name="arch" type="xml">
                <list default_order="change_date desc" create="false" edit="false" delete="false">
                    <field name="change_date"/>
                    <field name="salesperson_id"/>
                    <field name="route_id"/>
                    <field name="note"/>
                    <field name="changed_by_id"/>
                </list>
            </field>
        </record>

        <!-- Heredar Formulario de Contactos -->
        <record id="view_partner_form_kamaleon" model="ir.ui.view">
            <field name="name">res.partner.form.kamaleon</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="vat" position="after">
                    <field name="x_is_customer" widget="boolean_toggle"/>
                    <field name="x_route_id" placeholder="Seleccionar Ruta de Venta..." options="{'no_create_edit': True}"/>
                    <field name="x_rif" placeholder="e.g. J-12345678-9"/>
                    <field name="x_taxpayer_type" widget="radio"/>
                    <field name="x_credit_status" widget="badge"
                           decoration-danger="x_credit_status == 'blocked'"
                           decoration-warning="x_credit_status == 'override'"
                           decoration-success="x_credit_status == 'ok'"/>
                    <field name="x_blocked_invoice_info" invisible="not x_is_credit_blocked" readonly="1"/>
                    <field name="x_credit_blocked_override" widget="boolean_toggle" groups="account.group_account_manager,sales_team.group_sale_manager,base.group_system"/>
                </field>
                <xpath expr="//notebook" position="inside">
                    <page string="Historial de Vendedores" name="salesperson_history">
                        <field name="x_salesperson_history_ids" readonly="1"/>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Heredar Búsqueda de Contactos para filtrar y agrupar por Ruta -->
        <record id="view_res_partner_filter_kamaleon" model="ir.ui.view">
            <field name="name">res.partner.select.kamaleon</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <field name="x_route_id" string="Ruta de Venta"/>
                </field>
                <xpath expr="//group" position="inside">
                    <filter string="Ruta de Venta" name="group_by_x_route_id" context="{'group_by': 'x_route_id'}"/>
                    <filter string="Es Cliente" name="group_by_x_is_customer" context="{'group_by': 'x_is_customer'}"/>
                    <filter string="Bloqueado por Mora (>3 días)" name="filter_credit_blocked" domain="[('x_is_credit_blocked', '=', True)]"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
