<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Restricciones de vista para Vendedores Cotizador Touch.
            Se ocultan los botones de "Crear Factura" en el pedido de venta
            para usuarios del grupo group_vendedor_cotizador_touch.
            Ellos solo pueden crear y gestionar cotizaciones.
        -->
        <record id="view_order_form_kamaleon_vendedor" model="ir.ui.view">
            <field name="name">sale.order.form.kamaleon.vendedor</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Ocultar "Crear Factura" (cuando invoice_status = 'to invoice') -->
                <button id="create_invoice" position="attributes">
                    <attribute name="groups">!kamaleon_erp.group_vendedor_cotizador_touch</attribute>
                </button>
                <!-- Ocultar "Crear Factura" (anticipo/porcentaje) -->
                <button id="create_invoice_percentage" position="attributes">
                    <attribute name="groups">!kamaleon_erp.group_vendedor_cotizador_touch</attribute>
                </button>
            </field>
        </record>
    </data>
</odoo>
