<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Formato de Papel para Etiquetas de Góndola 6x3.8 cm (Compatible Carta y A4) -->
        <record id="paperformat_product_label_6x4" model="report.paperformat">
            <field name="name">Zais Express - Etiquetas Góndola 6x3.8cm</field>
            <field name="default" eval="False"/>
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">6</field>
            <field name="margin_bottom">6</field>
            <field name="margin_left">6</field>
            <field name="margin_right">6</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
        </record>

        <!-- Acción de Reporte para Plantilla de Productos (product.template) -->
        <record id="action_report_product_template_label_6x4" model="ir.actions.report">
            <field name="name">Etiquetas de Precios Góndola (6x3.8 cm)</field>
            <field name="model">product.template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">kamaleon_erp.report_product_label_6x4</field>
            <field name="report_file">kamaleon_erp.report_product_label_6x4</field>
            <field name="paperformat_id" ref="paperformat_product_label_6x4"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Acción de Reporte para Variantes de Producto (product.product) -->
        <record id="action_report_product_product_label_6x4" model="ir.actions.report">
            <field name="name">Etiquetas de Precios Góndola (6x3.8 cm)</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">kamaleon_erp.report_product_label_6x4</field>
            <field name="report_file">kamaleon_erp.report_product_label_6x4</field>
            <field name="paperformat_id" ref="paperformat_product_label_6x4"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_type">report</field>
        </record>

        <!-- Plantilla QWeb del Reporte de Etiquetas Góndola 6x3.8 cm (Letras Gigantes, Sin Recuadro de Precio) -->
        <template id="report_product_label_6x4">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <style>
                        body, html {
                            margin: 0 !important;
                            padding: 0 !important;
                            background: #ffffff !important;
                            font-family: Arial, Helvetica, sans-serif !important;
                        }
                        .label-page {
                            width: 100% !important;
                            clear: both !important;
                            page-break-inside: avoid !important;
                            overflow: hidden !important;
                        }
                        .label-table {
                            width: 100% !important;
                            table-layout: fixed !important;
                            border-collapse: separate !important;
                            border-spacing: 3.5mm 3mm !important;
                            margin: 0 auto !important;
                            padding: 0 !important;
                        }
                        .label-cell {
                            width: 33.333% !important;
                            height: 38mm !important;
                            vertical-align: top !important;
                            padding: 0 !important;
                            border: none !important;
                        }
                        .label-card {
                            width: 60mm !important;
                            height: 38mm !important;
                            margin: 0 auto !important;
                            border: 1px dashed #cbd5e1 !important; /* Guía de corte tenue para tijeras */
                            border-radius: 0 !important;
                            background: #ffffff !important;
                            box-sizing: border-box !important;
                            overflow: hidden !important;
                            position: relative !important;
                            padding: 2mm 2.5mm !important;
                        }
                        .label-name-section {
                            height: 21mm !important;
                            border: none !important;
                            text-align: center !important;
                            overflow: hidden !important;
                            display: table !important;
                            width: 100% !important;
                        }
                        .label-name-inner {
                            display: table-cell !important;
                            vertical-align: middle !important;
                            font-weight: 900 !important;
                            line-height: 1.15 !important;
                            text-transform: uppercase !important;
                            color: #000000 !important;
                            font-family: Arial, Helvetica, sans-serif !important;
                            max-height: 20mm !important;
                            word-break: break-word !important;
                        }
                        .label-price-section {
                            height: 14mm !important;
                            border: none !important; /* CERO BORDES NI RECUADROS */
                            padding: 0 !important;
                            box-sizing: border-box !important;
                            width: 100% !important;
                            display: table !important;
                            text-align: center !important;
                        }
                        .label-price-inner {
                            display: table-cell !important;
                            vertical-align: middle !important;
                            text-align: center !important;
                            border: none !important;
                        }
                    </style>

                    <t t-foreach="pages" t-as="page_rows">
                        <div class="label-page" t-att-style="'clear: both; width: 100%;' + (' page-break-before: always;' if page_rows_index &gt; 0 else '')">
                            <table class="label-table">
                                <t t-foreach="page_rows" t-as="row">
                                    <tr style="height: 38mm; page-break-inside: avoid;">
                                        <t t-foreach="row" t-as="cell">
                                            <td class="label-cell">
                                                <t t-if="cell">
                                                    <t t-set="item" t-value="cell"/>
                                                    <!-- Tarjeta de Etiqueta 6x3.8 cm (Limpia, Letras Gigantes, Sin Recuadro de Precio) -->
                                                    <div class="label-card">
                                                        <!-- 1. Nombre del Producto (Arriba - Letras Grandes y Negrita) -->
                                                        <div class="label-name-section">
                                                            <div class="label-name-inner"
                                                                 t-attf-style="{{ 'font-size: 15px !important;' if len(item['name']) &gt; 35 else ('font-size: 16.5px !important;' if len(item['name']) &gt; 22 else 'font-size: 18.5px !important;') }}">
                                                                <t t-esc="item['name']"/>
                                                            </div>
                                                        </div>

                                                        <!-- 2. Precio de Referencia (Abajo - Gigante, Sin Bordes ni Cuadro) -->
                                                        <div class="label-price-section">
                                                            <div class="label-price-inner">
                                                                <span style="font-size: 15px; font-weight: 900; font-family: Arial, Helvetica, sans-serif; color: #000000; margin-right: 6px; vertical-align: middle;">REF.: $</span>
                                                                <span style="font-size: 33px; font-weight: 900; font-family: Arial, Helvetica, sans-serif; color: #000000; letter-spacing: -0.5px; vertical-align: middle; white-space: nowrap;">
                                                                    <t t-esc="item['price']"/>
                                                                </span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ================================================================
             ETIQUETA DE OFERTAS HORIZONTAL RZ MARQUET (2 por hoja Letter)
             ================================================================ -->
        <record id="paperformat_product_label_oferta_19x15" model="report.paperformat">
            <field name="name">RZ Marquet - Etiqueta Ofertas (2 por hoja)</field>
            <field name="default" eval="False"/>
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">4</field>
            <field name="margin_bottom">4</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="disable_shrinking" eval="True"/>
            <field name="dpi">96</field>
        </record>

        <record id="action_report_product_template_label_oferta_19x15" model="ir.actions.report">
            <field name="name">Etiqueta de OFERTAS (2 en 1 hoja)</field>
            <field name="model">product.template</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">kamaleon_erp.report_product_label_oferta_19x15</field>
            <field name="report_file">kamaleon_erp.report_product_label_oferta_19x15</field>
            <field name="paperformat_id" ref="paperformat_product_label_oferta_19x15"/>
            <field name="binding_model_id" ref="product.model_product_template"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_product_product_label_oferta_19x15" model="ir.actions.report">
            <field name="name">Etiqueta de OFERTAS (2 en 1 hoja)</field>
            <field name="model">product.product</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">kamaleon_erp.report_product_label_oferta_19x15</field>
            <field name="report_file">kamaleon_erp.report_product_label_oferta_19x15</field>
            <field name="paperformat_id" ref="paperformat_product_label_oferta_19x15"/>
            <field name="binding_model_id" ref="product.model_product_product"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_product_label_oferta_19x15">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <style>
                        html, body {
                            margin: 0 !important;
                            padding: 0 !important;
                            background: #ffffff !important;
                        }
                        .article, .page { margin: 0 !important; padding: 0 !important; }
                        .of-page-pair {
                            width: 100% !important;
                            clear: both !important;
                            box-sizing: border-box !important;
                            overflow: hidden !important;
                            font-family: 'Arial Black', Arial, Helvetica, sans-serif !important;
                        }
                        .of-card {
                            position: relative;
                            width: 200mm;
                            height: 129mm;
                            margin: 0 auto;
                            border: 1.5mm solid #C8102E;
                            border-radius: 4mm;
                            overflow: hidden;
                            background: #ffffff;
                            box-sizing: border-box;
                        }
                        /* 1. Banda superior roja */
                        .of-banner {
                            position: absolute;
                            top: 0; left: 0;
                            width: 100%;
                            height: 28mm;
                            background: #C8102E;
                            background: -webkit-linear-gradient(left, #E3192B 0%, #B30D22 100%);
                            background: linear-gradient(90deg, #E3192B 0%, #B30D22 100%);
                        }
                        .of-banner-stripe {
                            position: absolute;
                            left: 0; bottom: 0;
                            width: 100%;
                            height: 2mm;
                            background: #FFD400;
                        }
                        .of-title {
                            position: absolute;
                            left: 8mm;
                            top: 2mm;
                            color: #ffffff;
                            font-size: 19mm;
                            line-height: 22mm;
                            font-weight: 900;
                            font-style: italic;
                            letter-spacing: 0.5mm;
                            text-shadow: 0.8mm 0.8mm 0 #7A0614;
                        }
                        /* Sello circular amarillo RZ Marquet */
                        .of-seal {
                            position: absolute;
                            right: 7mm;
                            top: 3mm;
                            width: 32mm;
                            height: 32mm;
                            border-radius: 50%;
                            background: #FFD400;
                            border: 1.2mm solid #ffffff;
                            box-shadow: 0 0 0 0.8mm #C8102E;
                            -webkit-transform: rotate(-10deg);
                            transform: rotate(-10deg);
                            text-align: center;
                            z-index: 5;
                        }
                        .of-seal-inner {
                            display: table;
                            width: 100%;
                            height: 100%;
                        }
                        .of-seal-text {
                            display: table-cell;
                            vertical-align: middle;
                            color: #C8102E;
                            font-weight: 900;
                            text-transform: uppercase;
                            line-height: 1.1;
                        }
                        /* 2. Nombre del producto */
                        .of-name {
                            position: absolute;
                            top: 32mm; left: 0;
                            width: 100%;
                            height: 32mm;
                            display: table;
                        }
                        .of-name-inner {
                            display: table-cell;
                            vertical-align: middle;
                            text-align: center;
                            padding: 0 8mm;
                            color: #111111;
                            font-weight: 900;
                            text-transform: uppercase;
                            line-height: 1.08;
                            word-wrap: break-word;
                        }
                        /* 3. Panel de precio limpio y gigante (Sin bordes) */
                        .of-price-wrapper {
                            position: absolute;
                            top: 64mm;
                            left: 0;
                            width: 100%;
                            height: 52mm;
                            border: none !important;
                            outline: none !important;
                            background: transparent !important;
                            text-align: center;
                            line-height: 52mm;
                        }
                        .of-price-center {
                            display: inline-block;
                            vertical-align: middle;
                            line-height: 1;
                            text-align: center;
                            border: none !important;
                        }
                        .of-ref-box {
                            display: inline-block;
                            vertical-align: middle;
                            margin-right: 8mm;
                            text-align: center;
                            border: none !important;
                        }
                        .of-ref-pill {
                            display: inline-block;
                            background: #C8102E;
                            color: #ffffff;
                            font-size: 9mm;
                            line-height: 13.5mm;
                            font-weight: 900;
                            padding: 0 4.5mm;
                            border-radius: 3mm;
                            letter-spacing: 0.5mm;
                        }
                        .of-ref-usd {
                            display: block;
                            margin-top: 1.5mm;
                            color: #C8102E;
                            font-size: 5mm;
                            font-weight: 900;
                            letter-spacing: 0.5mm;
                        }
                        .of-price-box {
                            display: inline-block;
                            vertical-align: middle;
                            white-space: nowrap;
                            border: none !important;
                        }
                        .of-price-int {
                            color: #000000;
                            font-weight: 900;
                            letter-spacing: -1.2mm;
                            line-height: 1;
                            white-space: nowrap;
                        }
                        .of-price-dec {
                            color: #000000;
                            font-weight: 900;
                            vertical-align: top;
                            line-height: 1;
                            margin-left: 1mm;
                        }
                        /* 4. Franja inferior */
                        .of-footer {
                            position: absolute;
                            left: 0; bottom: 0;
                            width: 100%;
                            height: 12mm;
                            background: transparent !important;
                            border: none !important;
                        }
                        .of-footer-table {
                            width: 100%;
                            height: 12mm;
                            border-collapse: collapse;
                            table-layout: fixed;
                            border: none !important;
                        }
                        .of-footer-table td {
                            border: none !important;
                            padding: 0;
                            vertical-align: middle;
                        }
                        .of-barcode {
                            color: #000000;
                            font-family: 'Consolas', 'Courier New', monospace;
                            font-size: 5.5mm;
                            font-weight: bold;
                            letter-spacing: 1.5mm;
                            white-space: nowrap;
                        }
                        .of-validity {
                            color: #D97706;
                            font-family: Arial, Helvetica, sans-serif;
                            font-size: 3mm;
                            font-weight: 900;
                            letter-spacing: 0.4mm;
                            text-align: right;
                            text-transform: uppercase;
                            white-space: nowrap;
                        }
                        .of-cut-line {
                            width: 200mm;
                            margin: 2mm auto;
                            text-align: center;
                            border-bottom: 1px dashed #94a3b8;
                            height: 2mm;
                            font-size: 8px;
                            color: #94a3b8;
                            line-height: 2mm;
                            overflow: hidden;
                        }
                    </style>

                    <t t-set="of_pages" t-value="pages_oferta if pages_oferta else [labels[i:i+2] for i in range(0, len(labels), 2)]"/>
                    <t t-foreach="of_pages" t-as="page_pair">
                        <div class="of-page-pair" t-att-style="'page-break-before: always;' if page_pair_index &gt; 0 else ''">
                            <t t-foreach="page_pair" t-as="item">
                                <div class="of-card">
                                    <!-- 1. Banda roja "¡OFERTA!" -->
                                    <div class="of-banner">
                                        <div class="of-title">¡OFERTA!</div>
                                        <div class="of-banner-stripe"/>
                                    </div>

                                    <!-- Sello amarillo RZ Marquet -->
                                    <div class="of-seal">
                                        <div class="of-seal-inner">
                                            <div class="of-seal-text">
                                                <div style="font-size: 3.6mm; letter-spacing: 0.2mm;">PRECIO</div>
                                                <div style="font-size: 5.5mm; margin-top: 0.5mm;">ESPECIAL</div>
                                                <div style="font-size: 5mm; margin-top: 0.4mm;">★★★</div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 2. Nombre del producto (tamaño automático según largo) -->
                                    <div class="of-name">
                                        <div class="of-name-inner" t-att-style="'font-size: %smm;' % (round(item['name_size'] * 0.9, 1))">
                                            <t t-esc="item['name']"/>
                                        </div>
                                    </div>

                                    <!-- 3. Precio REF gigante limpio (Sin bordes) -->
                                    <div class="of-price-wrapper">
                                        <div class="of-price-center">
                                            <div class="of-ref-box">
                                                <span class="of-ref-pill">REF</span>
                                                <span class="of-ref-usd">USD $</span>
                                            </div>
                                            <div class="of-price-box">
                                                <span class="of-price-int" t-att-style="'font-size: %smm;' % (round(item['price_size'] * 0.9, 1))"><t t-esc="item['price_int']"/></span><span class="of-price-dec" t-att-style="'font-size: %smm;' % round(item['price_size'] * 0.4, 1)">.<t t-esc="item['price_dec']"/></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- 4. Franja inferior: código de barras negro + validez -->
                                    <div class="of-footer">
                                        <table class="of-footer-table">
                                            <tr>
                                                <td style="width: 48%; text-align: left; padding-left: 7mm;">
                                                    <span class="of-barcode">
                                                        <t t-esc="item['barcode'] or item['default_code'] or ''"/>
                                                    </span>
                                                </td>
                                                <td style="width: 52%; text-align: right; padding-right: 14mm;">
                                                    <span class="of-validity">
                                                        Válido hasta agotar existencia
                                                    </span>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <!-- Línea guía de corte entre las dos etiquetas -->
                                <t t-if="item_index == 0 and len(page_pair) &gt; 1">
                                    <div class="of-cut-line">
                                        ✂ - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - ✂
                                    </div>
                                </t>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
